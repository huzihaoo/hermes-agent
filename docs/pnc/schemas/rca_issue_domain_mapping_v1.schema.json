{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minieye.internal/schemas/rca_issue_domain_mapping_v1.json",
  "title": "G1Q3 RCA owner-approved Feishu domain mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_key",
    "work_item_type",
    "field_key",
    "taxonomy_sha256",
    "approval",
    "rules"
  ],
  "properties": {
    "schema_version": {"const": "rca_issue_domain_mapping_v1"},
    "project_key": {"const": "t03o4q"},
    "work_item_type": {"const": "issue"},
    "field_key": {"const": "field_e776bb"},
    "taxonomy_sha256": {"$ref": "#/$defs/sha256"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "approved_by", "approved_at", "receipt_sha256"],
      "properties": {
        "authority": {"const": "PDCL/data owner"},
        "approved_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "approved_at": {"$ref": "#/$defs/timestamp"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["function_domain", "option_ids", "option_path"],
        "properties": {
          "function_domain": {"enum": ["ACC", "LCC", "AEB", "FCW"]},
          "option_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "option_path": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
