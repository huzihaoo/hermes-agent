{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minieye.internal/schemas/pnc_rca_real_feishu_frame_census_v1.json",
  "title": "PNC RCA real Feishu frame input census",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "task_id",
    "source",
    "summary",
    "records",
    "contains_raw_field_values",
    "contains_credentials",
    "mutation_performed"
  ],
  "properties": {
    "schema_version": {"const": "pnc_rca_real_feishu_frame_census_v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "project_key", "work_item_type_key", "selected_field_keys"],
      "properties": {
        "kind": {"const": "official_meegle_read_only"},
        "project_key": {"const": "t03o4q"},
        "work_item_type_key": {"const": "issue"},
        "selected_field_keys": {
          "const": ["field_1fda45", "field_9193cb", "field_8c912e"]
        }
      }
    },
    "summary": {"type": "object"},
    "records": {"type": "array", "minItems": 1, "maxItems": 200},
    "contains_raw_field_values": {"const": false},
    "contains_credentials": {"const": false},
    "mutation_performed": {"const": false}
  }
}
