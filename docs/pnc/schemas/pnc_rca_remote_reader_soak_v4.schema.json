{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minieye.internal/schemas/pnc_rca_remote_reader_soak_v4.json",
  "title": "G1Q3 RCA remote-reader soak evidence v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observed_at",
    "ok",
    "source",
    "candidate_binding",
    "dependency_binding",
    "workload_manifest",
    "policy",
    "started_at",
    "ended_at",
    "duration_seconds",
    "attempted_cases",
    "completed_cases",
    "concurrency_peak",
    "concurrency_profile",
    "temporal_profile",
    "capacity_lifecycle",
    "workload_mix",
    "case_evidence",
    "zero_invariants",
    "latency_ms",
    "throughput",
    "resources",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "pnc_rca_remote_reader_soak_v4"},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "ok": {"const": true},
    "source": {"$ref": "#/$defs/source"},
    "candidate_binding": {"$ref": "#/$defs/candidate"},
    "dependency_binding": {"$ref": "#/$defs/dependency"},
    "workload_manifest": {"$ref": "#/$defs/workloadManifest"},
    "policy": {"$ref": "#/$defs/policy"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "ended_at": {"$ref": "#/$defs/timestamp"},
    "duration_seconds": {"type": "integer", "minimum": 86400},
    "attempted_cases": {"type": "integer", "minimum": 200},
    "completed_cases": {"type": "integer", "minimum": 200},
    "concurrency_peak": {"const": 4},
    "concurrency_profile": {"$ref": "#/$defs/concurrencyProfile"},
    "temporal_profile": {"$ref": "#/$defs/temporalProfile"},
    "capacity_lifecycle": {"$ref": "#/$defs/capacityLifecycle"},
    "workload_mix": {"$ref": "#/$defs/workloadMix"},
    "case_evidence": {"$ref": "#/$defs/caseEvidence"},
    "zero_invariants": {"$ref": "#/$defs/zeroInvariants"},
    "latency_ms": {"$ref": "#/$defs/latency"},
    "throughput": {"$ref": "#/$defs/throughput"},
    "resources": {"$ref": "#/$defs/resources"},
    "errors": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_mode",
        "component",
        "component_commit",
        "component_tree",
        "module",
        "module_sha256",
        "entrypoint",
        "entrypoint_sha256",
        "schema",
        "schema_sha256"
      ],
      "properties": {
        "generation_mode": {"const": "machine_generated"},
        "component": {"const": "pnc_rca_remote_reader_soak"},
        "component_commit": {"$ref": "#/$defs/commit"},
        "component_tree": {"$ref": "#/$defs/commit"},
        "module": {"const": "api/g1q3_rca/remote_reader_soak.py"},
        "module_sha256": {"$ref": "#/$defs/sha256"},
        "entrypoint": {"const": "api/g1q3_rca/scripts/run_remote_reader_soak.py"},
        "entrypoint_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"const": "api/g1q3_rca/schemas/pnc_rca_remote_reader_soak_v4.schema.json"},
        "schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "base_tree", "execution_commit", "execution_tree", "clean"],
      "properties": {
        "base_commit": {"$ref": "#/$defs/commit"},
        "base_tree": {"$ref": "#/$defs/commit"},
        "execution_commit": {"$ref": "#/$defs/commit"},
        "execution_tree": {"$ref": "#/$defs/commit"},
        "clean": {"const": true}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "wheel_sha256", "runtime_proof_sha256", "dependency_doctor_sha256", "remote_reader_health_sha256", "fingerprint_material", "reader_fingerprint_material", "fingerprint", "reader_fingerprint"],
      "properties": {
        "distribution": {"const": "pdcl_pyclip"},
        "version": {"const": "0.1.6+rca.2"},
        "wheel_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_proof_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_doctor_sha256": {"$ref": "#/$defs/sha256"},
        "remote_reader_health_sha256": {"$ref": "#/$defs/sha256"},
        "fingerprint_material": {"type": "object"},
        "reader_fingerprint_material": {"type": "object"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "reader_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "workloadManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sha256", "case_count", "unique_work_items", "unique_references", "domain_counts", "reader_class_counts", "source"],
      "properties": {
        "schema_version": {"const": "pnc_rca_remote_reader_soak_manifest_v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "case_count": {"type": "integer", "minimum": 200},
        "unique_work_items": {"type": "integer", "minimum": 200},
        "unique_references": {"type": "integer", "minimum": 200},
        "domain_counts": {"$ref": "#/$defs/countMap"},
        "reader_class_counts": {"$ref": "#/$defs/countMap"},
        "source": {"type": "object"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "min_cases", "domain_quotas", "reader_class_quotas", "max_concurrency", "per_case_timeout_seconds", "minimum_seconds_at_reserve", "minimum_longest_sustained_seconds", "temporal_bucket_seconds", "minimum_temporal_buckets", "maximum_temporal_gap_seconds", "max_clips", "max_messages", "max_scanned_messages", "max_output_bytes", "retry_count", "input_materialization", "fallback"],
      "properties": {
        "duration_seconds": {"const": 86400},
        "min_cases": {"const": 200},
        "domain_quotas": {
          "const": {"ACC": 50, "AEB_FCW": 50, "DNP": 50, "LCC": 50}
        },
        "reader_class_quotas": {
          "const": {"RemoteClipReader": 25, "RemoteEventReader": 25}
        },
        "max_concurrency": {"const": 4},
        "per_case_timeout_seconds": {"const": 120},
        "minimum_seconds_at_reserve": {"const": 900},
        "minimum_longest_sustained_seconds": {"const": 300},
        "temporal_bucket_seconds": {"const": 3600},
        "minimum_temporal_buckets": {"const": 24},
        "maximum_temporal_gap_seconds": {"const": 3600},
        "max_clips": {"const": 16},
        "max_messages": {"const": 250000},
        "max_scanned_messages": {"const": 1000000},
        "max_output_bytes": {"const": 750000000},
        "retry_count": {"const": 0},
        "input_materialization": {"const": "forbidden"},
        "fallback": {"const": "forbidden"}
      }
    },
    "workloadMix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reader_class_cases", "function_domain_cases", "reference_kind_cases", "unique_work_items", "unique_data_references"],
      "properties": {
        "reader_class_cases": {"$ref": "#/$defs/countMap"},
        "function_domain_cases": {"$ref": "#/$defs/countMap"},
        "reference_kind_cases": {"$ref": "#/$defs/countMap"},
        "unique_work_items": {"type": "integer", "minimum": 200},
        "unique_data_references": {"type": "integer", "minimum": 200}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reader_class", "locator_field", "locator_sha256", "reference_binding_sha256"],
      "properties": {
        "kind": {"enum": ["clip", "event"]},
        "reader_class": {"enum": ["RemoteClipReader", "RemoteEventReader"]},
        "locator_field": {"enum": ["clip_uuid", "event_uuid"]},
        "locator_sha256": {"$ref": "#/$defs/sha256"},
        "reference_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requestedScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "requirements"],
      "properties": {
        "source": {"const": "vm_evaluator_scope_contract"},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "requirements_contract_version", "requirements_contract_hash", "function_domain", "requested_topics", "channel_allowlist", "frame_lookup", "frame_channel_allowlist", "requested_window", "evaluator_fingerprints", "requirements_hash"],
          "properties": {
            "schema_version": {"const": "g1q3_rca_remote_evidence_requirements_v1"},
            "requirements_contract_version": {"const": "g1q3_rca_evaluator_scope_v1"},
            "requirements_contract_hash": {"$ref": "#/$defs/sha256"},
            "function_domain": {"enum": ["ACC", "LCC", "AEB", "FCW", "DNP"]},
            "requested_topics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "channel_allowlist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "frame_lookup": {"const": {}},
            "frame_channel_allowlist": {"const": []},
            "requested_window": {
              "const": {"end_time_ns": null, "mode": "full_reference", "start_time_ns": null}
            },
            "evaluator_fingerprints": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            },
            "requirements_hash": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "scopeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements_contract_sha256", "requirements_sha256", "requested_scope_sha256"],
      "properties": {
        "requirements_contract_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_sha256": {"$ref": "#/$defs/sha256"},
        "requested_scope_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "remoteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "relative_path", "sha256", "completeness", "exhausted", "message_count", "bytes"],
      "properties": {
        "schema_version": {"const": "g1q3_rca_remote_read_receipt_v1"},
        "status": {"const": "completed"},
        "relative_path": {"type": "string", "pattern": "^cases/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "completeness": {"const": "full_requested_scope"},
        "exhausted": {"const": true},
        "message_count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_materialized", "input_materialized_bytes", "mdi_invocation_count", "download_invocation_count", "fallback_count", "retained_stream_cache_bytes", "observation"],
      "properties": {
        "input_materialized": {"const": false},
        "input_materialized_bytes": {"const": 0},
        "mdi_invocation_count": {"const": 0},
        "download_invocation_count": {"const": 0},
        "fallback_count": {"const": 0},
        "retained_stream_cache_bytes": {"const": 0},
        "observation": {"const": "remote_receipt_verified_stream_cache_removed_v1"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_ms", "offset_start_ms", "offset_end_ms"],
      "properties": {
        "started_at": {"$ref": "#/$defs/timestamp"},
        "ended_at": {"$ref": "#/$defs/timestamp"},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
        "offset_start_ms": {"type": "integer", "minimum": 0},
        "offset_end_ms": {"type": "integer", "minimum": 0}
      }
    },
    "caseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "case_id", "work_item_id", "function_domain", "quota_domain", "workload_manifest_record_sha256", "reference", "requested_scope", "requested_scope_binding", "candidate_binding", "dependency_fingerprint", "reader_fingerprint", "remote_receipt", "materialization", "timing", "record_sha256"],
      "properties": {
        "schema_version": {"const": "pnc_rca_remote_reader_soak_case_v1"},
        "case_id": {"$ref": "#/$defs/identifier"},
        "work_item_id": {"$ref": "#/$defs/identifier"},
        "function_domain": {"enum": ["ACC", "LCC", "AEB", "FCW", "DNP"]},
        "quota_domain": {"enum": ["ACC", "LCC", "AEB_FCW", "DNP"]},
        "workload_manifest_record_sha256": {"$ref": "#/$defs/sha256"},
        "reference": {"$ref": "#/$defs/reference"},
        "requested_scope": {"$ref": "#/$defs/requestedScope"},
        "requested_scope_binding": {"$ref": "#/$defs/scopeBinding"},
        "candidate_binding": {"$ref": "#/$defs/candidate"},
        "dependency_fingerprint": {"$ref": "#/$defs/sha256"},
        "reader_fingerprint": {"$ref": "#/$defs/sha256"},
        "remote_receipt": {"$ref": "#/$defs/remoteReceipt"},
        "materialization": {"$ref": "#/$defs/materialization"},
        "timing": {"$ref": "#/$defs/timing"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "caseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_schema", "records", "record_count", "record_hashes", "merkle_algorithm", "merkle_root"],
      "properties": {
        "record_schema": {"const": "pnc_rca_remote_reader_soak_case_v1"},
        "records": {"type": "array", "minItems": 200, "items": {"$ref": "#/$defs/caseRecord"}},
        "record_count": {"type": "integer", "minimum": 200},
        "record_hashes": {"type": "array", "minItems": 200, "items": {"$ref": "#/$defs/sha256"}},
        "merkle_algorithm": {"const": "sha256-domain-separated-duplicate-last-v1"},
        "merkle_root": {"$ref": "#/$defs/sha256"}
      }
    },
    "zeroInvariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_count", "input_materialized_count", "input_materialized_bytes", "retained_stream_cache_bytes", "mdi_invocation_count", "download_invocation_count", "fallback_count", "timeout_count", "rate_limit_count", "reconnect_count", "retry_count", "completeness_failure_count"],
      "properties": {
        "error_count": {"const": 0},
        "input_materialized_count": {"const": 0},
        "input_materialized_bytes": {"const": 0},
        "retained_stream_cache_bytes": {"const": 0},
        "mdi_invocation_count": {"const": 0},
        "download_invocation_count": {"const": 0},
        "fallback_count": {"const": 0},
        "timeout_count": {"const": 0},
        "rate_limit_count": {"const": 0},
        "reconnect_count": {"const": 0},
        "retry_count": {"const": 0},
        "completeness_failure_count": {"const": 0}
      }
    },
    "concurrencyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserved_cases", "peak", "sample_interval_seconds", "samples_total", "samples_at_or_above_reserved", "longest_sustained_seconds_at_or_above_reserved", "over_admission_count"],
      "properties": {
        "reserved_cases": {"const": 4},
        "peak": {"const": 4},
        "sample_interval_seconds": {"const": 10},
        "samples_total": {"type": "integer", "minimum": 8640},
        "samples_at_or_above_reserved": {"type": "integer", "minimum": 90},
        "longest_sustained_seconds_at_or_above_reserved": {"type": "integer", "minimum": 300},
        "over_admission_count": {"const": 0}
      }
    },
    "temporalProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket_seconds", "minimum_buckets", "minimum_cases_per_bucket", "scheduler_tolerance_seconds", "bucket_start_counts", "covered_bucket_count", "first_bucket_covered", "last_bucket_covered", "maximum_start_gap_ms", "maximum_allowed_start_gap_ms"],
      "properties": {
        "bucket_seconds": {"const": 3600},
        "minimum_buckets": {"const": 24},
        "minimum_cases_per_bucket": {"const": 4},
        "scheduler_tolerance_seconds": {"const": 30},
        "bucket_start_counts": {
          "type": "object",
          "minProperties": 24,
          "maxProperties": 24,
          "additionalProperties": {"type": "integer", "minimum": 4}
        },
        "covered_bucket_count": {"const": 24},
        "first_bucket_covered": {"const": true},
        "last_bucket_covered": {"const": true},
        "maximum_start_gap_ms": {"type": "integer", "minimum": 0, "maximum": 3630000},
        "maximum_allowed_start_gap_ms": {"const": 3630000}
      }
    },
    "capacityLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservation_count", "activation_count", "release_count", "terminal_proven_count", "peak_held_cases", "held_bytes_leak_count", "stale_lease_count", "fence_conflict_count", "release_failure_count"],
      "properties": {
        "reservation_count": {"type": "integer", "minimum": 200},
        "activation_count": {"type": "integer", "minimum": 200},
        "release_count": {"type": "integer", "minimum": 200},
        "terminal_proven_count": {"type": "integer", "minimum": 200},
        "peak_held_cases": {"const": 4},
        "held_bytes_leak_count": {"const": 0},
        "stale_lease_count": {"const": 0},
        "fence_conflict_count": {"const": 0},
        "release_failure_count": {"const": 0}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "max"],
      "properties": {
        "p50": {"type": "number", "minimum": 0, "maximum": 120000},
        "p95": {"type": "number", "minimum": 0, "maximum": 120000},
        "p99": {"type": "number", "minimum": 0, "maximum": 120000},
        "max": {"type": "number", "minimum": 0, "maximum": 120000}
      }
    },
    "throughput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages_total", "bytes_total", "messages_per_second", "bytes_per_second"],
      "properties": {
        "messages_total": {"type": "integer", "minimum": 200},
        "bytes_total": {"type": "integer", "minimum": 200},
        "messages_per_second": {"type": "number", "exclusiveMinimum": 0},
        "bytes_per_second": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rss_peak_bytes", "fd_peak", "fd_limit", "open_reader_peak", "concurrency_peak"],
      "properties": {
        "rss_peak_bytes": {"type": "integer", "minimum": 1},
        "fd_peak": {"type": "integer", "minimum": 1},
        "fd_limit": {"type": "integer", "minimum": 1},
        "open_reader_peak": {"type": "integer", "minimum": 1, "maximum": 4},
        "concurrency_peak": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    }
  }
}
