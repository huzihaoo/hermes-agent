{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minieye.internal/schemas/pnc_rca_kafka_e2e_canary_manifest_v1.json",
  "title": "PNC RCA real Kafka-to-Feishu E2E canary manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "task_id",
    "source",
    "work_item_ids",
    "required_kafka_evidence",
    "contains_raw_title",
    "contains_raw_pdcl_reference",
    "contains_credential"
  ],
  "properties": {
    "schema_version": {"const": "pnc_rca_kafka_e2e_canary_manifest_v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_key",
        "project_simple_name",
        "work_item_type_key",
        "feishu_plugin_source",
        "feishu_receipt_path",
        "screenshot_sha256",
        "feishu_receipt_sha256"
      ],
      "properties": {
        "project_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "project_simple_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "work_item_type_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "feishu_plugin_source": {"type": "string", "minLength": 1, "maxLength": 256},
        "feishu_receipt_path": {"type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/"},
        "screenshot_sha256": {"$ref": "#/$defs/sha256"},
        "feishu_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "work_item_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[1-9][0-9]{0,31}$"}
    },
    "required_kafka_evidence": {
      "const": {
        "window_days": 7,
        "all_work_items_observed": true,
        "all_work_items_accepted": true,
        "all_triggers_created_or_deduplicated": true,
        "shadow_outbox_only": true,
        "commit_performed": false
      }
    },
    "contains_raw_title": {"const": false},
    "contains_raw_pdcl_reference": {"const": false},
    "contains_credential": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
