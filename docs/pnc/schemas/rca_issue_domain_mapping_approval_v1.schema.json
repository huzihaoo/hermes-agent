{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minieye.internal/schemas/rca_issue_domain_mapping_approval_v1.json",
  "title": "G1Q3 RCA Feishu domain mapping owner approval receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "approved_by",
    "approved_at",
    "mapping_rules_sha256"
  ],
  "properties": {
    "schema_version": {"const": "rca_issue_domain_mapping_approval_v1"},
    "authority": {"const": "PDCL/data owner"},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_at": {"$ref": "#/$defs/timestamp"},
    "mapping_rules_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    }
  }
}
