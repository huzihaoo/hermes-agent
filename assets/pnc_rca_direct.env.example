# Shared owner-only runtime contract for both direct LaunchAgents.
# Install this file as direct.env with mode 0600.
# The blank SASL values are deliberate: inject credentials out of band before
# enabling the consumer; this example must fail closed when copied unchanged.
# Consumer contract (the Kafka process reads these keys).
HERMES_RCA_DIRECT_KAFKA_BOOTSTRAP_SERVERS=broker.example.invalid:9092
HERMES_RCA_DIRECT_KAFKA_TOPIC=feishu-project-workflow-event
HERMES_RCA_DIRECT_KAFKA_GROUP_ID=rca_direct_path
HERMES_RCA_DIRECT_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
HERMES_RCA_DIRECT_KAFKA_SASL_MECHANISM=PLAIN
HERMES_RCA_DIRECT_KAFKA_SASL_USERNAME=
HERMES_RCA_DIRECT_KAFKA_SASL_PASSWORD=
HERMES_RCA_DIRECT_KAFKA_POLICY_JSON='{"policy_version":"issue-created-v1","project_keys":["project-key"],"project_simple_names":["g1q3"],"snapshot_patterns":[],"snapshot_sub_stages":[],"status_change_types":["Reached"],"topic":"feishu-project-workflow-event","transitions":[{"cur_status":2,"pre_status":1,"state_key":"new-problem-state"}],"work_item_type_keys":["problem-type"]}'
# Keep offset commits disabled in the checked-in example.  An owner-reviewed
# production cutover must explicitly flip this together with the stable-group
# and credential checks.
HERMES_RCA_DIRECT_KAFKA_COMMIT_ENABLED=false
HERMES_RCA_DIRECT_KAFKA_AUTO_OFFSET_RESET=none
HERMES_RCA_DIRECT_KAFKA_DB_PATH=/Users/songying/.hermes/runtime/pnc_agent/feishu_issue_kafka_rca_direct/mini.sqlite3
HERMES_RCA_DIRECT_KAFKA_HEALTH_PATH=/Users/songying/.hermes/runtime/pnc_agent/feishu_issue_kafka_rca_direct/consumer_health.json
# Dispatcher contract (the outbox process reads these keys).
HERMES_RCA_DIRECT_OUTBOX_ENABLED=false
HERMES_RCA_DIRECT_OUTBOX_SUBMIT_ENABLED=false
HERMES_RCA_DIRECT_OUTBOX_LEASE_SECONDS=300
HERMES_RCA_DIRECT_OUTBOX_POLL_INTERVAL_SECONDS=5
HERMES_RCA_DIRECT_OUTBOX_MAX_BATCH_SIZE=1
HERMES_RCA_DIRECT_OUTBOX_DB_PATH=/Users/songying/.hermes/runtime/pnc_agent/feishu_issue_kafka_rca_direct/mini.sqlite3
HERMES_RCA_DIRECT_OUTBOX_HEALTH_PATH=/Users/songying/.hermes/runtime/pnc_agent/feishu_issue_kafka_rca_direct/outbox_dispatcher_health.json
HERMES_RCA_DIRECT_OUTBOX_AUTH_PRINCIPAL=pnc-rca-direct-outbox
HERMES_RCA_DIRECT_OUTBOX_AUTH_CAPABILITY=g1q3_rca_direct_vm_submit
