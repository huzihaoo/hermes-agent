{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnc_rca_active_evaluator_inventory_v1.schema.json",
  "title": "G1Q3 RCA active evaluator inventory artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_commit",
    "pipeline_tree",
    "active_evaluator_ids"
  ],
  "properties": {
    "schema_version": {"const": "g1q3_rca_active_evaluator_inventory_v1"},
    "pipeline_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "pipeline_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "active_evaluator_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
    }
  }
}
