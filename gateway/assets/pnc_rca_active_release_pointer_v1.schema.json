{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnc_rca_active_release_pointer_v1.schema.json",
  "title": "PNC RCA active release pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "release_id",
    "authority_path",
    "authority_sha256",
    "activated_at",
    "previous_authority_sha256"
  ],
  "properties": {
    "schema_version": {"const": "pnc_rca_active_release_pointer_v1"},
    "state": {"enum": ["candidate", "active"]},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"},
    "authority_path": {"type": "string", "pattern": "^/"},
    "authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activated_at": {"type": "string", "format": "date-time"},
    "previous_authority_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    }
  }
}
