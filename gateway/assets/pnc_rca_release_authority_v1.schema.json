{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnc_rca_release_authority_v1.schema.json",
  "title": "PNC RCA cross-plane release authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "authority_epoch_id",
    "created_at",
    "status",
    "supersedes_authority_sha256",
    "faces",
    "control_store",
    "quarantine_baseline",
    "side_effect_policy",
    "report_publication",
    "feishu_capability"
  ],
  "properties": {
    "schema_version": {"const": "pnc_rca_release_authority_v1"},
    "release_id": {"$ref": "#/$defs/identifier"},
    "authority_epoch_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["candidate_only", "approved_for_activation"]},
    "supersedes_authority_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}, {"const": ""}]
    },
    "faces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_runtime",
        "vm_worker_state",
        "g1q3_rca_pipeline",
        "mcap_data_translate"
      ],
      "properties": {
        "host_runtime": {"$ref": "#/$defs/face"},
        "vm_worker_state": {"$ref": "#/$defs/face"},
        "g1q3_rca_pipeline": {"$ref": "#/$defs/face"},
        "mcap_data_translate": {"$ref": "#/$defs/mcapFace"}
      }
    },
    "control_store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "database_instance_id",
        "schema_fingerprint_sha256",
        "backup_receipt_sha256",
        "not_measured_reason"
      ],
      "properties": {
        "schema_version": {"$ref": "#/$defs/identifier"},
        "database_instance_id": {"$ref": "#/$defs/identifier"},
        "schema_fingerprint_sha256": {"$ref": "#/$defs/nullableSha256"},
        "backup_receipt_sha256": {"$ref": "#/$defs/nullableSha256"},
        "not_measured_reason": {"type": "string"}
      }
    },
    "quarantine_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "required",
        "schema_version",
        "baseline_sha256",
        "not_measured_reason"
      ],
      "properties": {
        "state": {"enum": ["ready", "not_applicable", "not_measured"]},
        "required": {"type": ["boolean", "null"]},
        "schema_version": {"type": ["string", "null"]},
        "baseline_sha256": {"$ref": "#/$defs/nullableSha256"},
        "not_measured_reason": {"type": "string"}
      }
    },
    "side_effect_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "single_active_writer",
        "allow_historical_requeue",
        "allowed_effect_kinds"
      ],
      "properties": {
        "mode": {"enum": ["disabled", "shadow", "canary", "enabled"]},
        "single_active_writer": {"const": true},
        "allow_historical_requeue": {"const": false},
        "allowed_effect_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "report_publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_base_url", "root", "manifest_schema_version"],
      "properties": {
        "canonical_base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "root": {"type": "string", "pattern": "^/"},
        "manifest_schema_version": {"$ref": "#/$defs/identifier"}
      }
    },
    "feishu_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_surfaces",
        "capability_profile_sha256",
        "not_measured_reason"
      ],
      "properties": {
        "required_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "capability_profile_sha256": {"$ref": "#/$defs/nullableSha256"},
        "not_measured_reason": {"type": "string"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "root"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "root": {"type": "string", "pattern": "^/"}
      }
    },
    "mcapFace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "root", "contract_sha256"],
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"},
        "root": {"type": "string", "pattern": "^/"},
        "contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
