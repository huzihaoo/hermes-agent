{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pnc_rca_release_stage_status_v1.schema.json",
  "title": "PNC RCA release stage status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_sha256", "observed_at", "stages"],
  "properties": {
    "schema_version": {"const": "pnc_rca_release_stage_status_v1"},
    "authority_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_validated",
        "installed",
        "resident_loaded",
        "control_plane_compatible",
        "execution_ready",
        "delivery_ready",
        "live_write_observed",
        "remote_receipt_proven"
      ],
      "properties": {
        "candidate_validated": {"$ref": "#/$defs/stage"},
        "installed": {"$ref": "#/$defs/stage"},
        "resident_loaded": {"$ref": "#/$defs/stage"},
        "control_plane_compatible": {"$ref": "#/$defs/stage"},
        "execution_ready": {"$ref": "#/$defs/stage"},
        "delivery_ready": {"$ref": "#/$defs/stage"},
        "live_write_observed": {"$ref": "#/$defs/stage"},
        "remote_receipt_proven": {"$ref": "#/$defs/stage"}
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at", "evidence_sha256", "reason"],
      "properties": {
        "status": {"enum": ["pass", "fail", "not_measured", "not_applicable"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "reason": {"type": "string"}
      }
    }
  }
}
